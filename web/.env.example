# URL publique du site (dev : port 3003)
NEXT_PUBLIC_APP_URL=http://localhost:3003

# Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Démo LOCAL uniquement — ignoré automatiquement en production
DEMO_MODE=false

# Email (Resend — https://resend.com)
RESEND_API_KEY=re_...
EMAIL_FROM=RénovSûr <noreply@renovsur.fr>

# Auth compte (générer une chaîne aléatoire 32+ caractères)
AUTH_SECRET=changez-moi-en-production-minimum-32-caracteres

# Mentions légales (obligatoire avant mise en ligne publique)
LEGAL_COMPANY_NAME=
LEGAL_SIRET=
LEGAL_ADDRESS=
LEGAL_DIRECTOR=

# IA — lecture de devis (rapports payants uniquement, optionnel)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stockage persistant Vercel (Storage → Blob → créer, puis lier au projet)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# En production : DEMO_MODE ignoré, STRIPE_SECRET_KEY + AUTH_SECRET + BLOB obligatoires
